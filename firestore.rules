rules_version = '2';

// Security model (there is no server: these rules ARE the access control).
//
// - The manager signs in with Firebase Auth. A user is a manager when admins/{uid} exists;
//   that collection is written only by the mailer job (Admin SDK) from the ADMIN_EMAILS secret.
// - The shared board is public: teams, workers' names, projects, tasks, equipment and meetings
//   can be read by anyone. Workers' emails and personal-link tokens live in workerPrivate,
//   which only the manager can read.
// - Workers don't log in. Their personal link holds a secret token. To change something, the
//   worker page writes, in ONE batch, a new proofs/{id} doc {token, workerId} together with the
//   change, which points to it with proofId. The rules check that the proof is created in this
//   very request (so an old proof id can't be replayed) and that the token belongs to that
//   worker. Proofs can't be read, so tokens never become public.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function optDate(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // True when proofs/{proofId} is created by this same request, for an active worker whose
    // personal-link token matches.
    function freshProof(proofId, workerId) {
      let proof = getAfter(/databases/$(database)/documents/proofs/$(proofId)).data;
      return proofId is string
        && !exists(/databases/$(database)/documents/proofs/$(proofId))
        && existsAfter(/databases/$(database)/documents/proofs/$(proofId))
        && proof.workerId == workerId
        && get(/databases/$(database)/documents/workerLinks/$(proof.token)).data.workerId == workerId
        && get(/databases/$(database)/documents/workers/$(workerId)).data.active == true;
    }

    // ---------------------------------------------------------------- manager-only

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    match /workerPrivate/{workerId} {
      allow read, write: if isAdmin();
    }

    match /emailLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A personal link can look up its own worker, but nobody can list the tokens.
    match /workerLinks/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /proofs/{proofId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['token', 'workerId', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.workerId is string
        && request.resource.data.createdAt is int
        && get(/databases/$(database)/documents/workerLinks/$(request.resource.data.token)).data.workerId == request.resource.data.workerId;
    }

    // ---------------------------------------------------------------- public read, manager write

    match /teams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- worker writes with proof

    match /tasks/{taskId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.assigneeId is string
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'completedAt', 'lastComment', 'lastProofId', 'updatedAt'])
        && request.resource.data.status in ['TODO', 'IN_PROGRESS', 'BLOCKED', 'DONE']
        && optString(request.resource.data.lastComment, 1000)
        && freshProof(request.resource.data.lastProofId, resource.data.assigneeId)
      );
    }

    match /taskUpdates/{id} {
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['taskId', 'workerId', 'oldStatus', 'newStatus', 'comment', 'proofId', 'createdAt'])
        && request.resource.data.workerId is string
        && optString(request.resource.data.comment, 1000)
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.assigneeId == request.resource.data.workerId
        && freshProof(request.resource.data.proofId, request.resource.data.workerId)
      );
    }

    match /equipment/{id} {
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['item', 'quantity', 'link', 'estCost', 'notes', 'neededBy', 'status',
          'managerNote', 'requesterId', 'projectId', 'proofId', 'approvedAt', 'orderedAt', 'receivedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'PENDING'
        && request.resource.data.item is string && request.resource.data.item.size() > 0 && request.resource.data.item.size() <= 200
        && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 10000
        && (request.resource.data.estCost == null || request.resource.data.estCost is number)
        && optString(request.resource.data.link, 500)
        && optString(request.resource.data.notes, 2000)
        && optDate(request.resource.data.neededBy)
        && request.resource.data.managerNote == null
        && request.resource.data.approvedAt == null
        && request.resource.data.orderedAt == null
        && request.resource.data.receivedAt == null
        && freshProof(request.resource.data.proofId, request.resource.data.requesterId)
      );
    }

    match /meetings/{id} {
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['topic', 'notes', 'neededBy', 'status', 'withTeamId', 'requesterId', 'proofId', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'OPEN'
        && request.resource.data.topic is string && request.resource.data.topic.size() > 0 && request.resource.data.topic.size() <= 200
        && optString(request.resource.data.notes, 2000)
        && optDate(request.resource.data.neededBy)
        && freshProof(request.resource.data.proofId, request.resource.data.requesterId)
      );
    }

    // Emails waiting to be sent by the mailer job. Workers may only queue a notice to the manager.
    match /outbox/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['type', 'subject', 'lines', 'path', 'proofId', 'status', 'createdAt'])
        && request.resource.data.type == 'manager-notice'
        && request.resource.data.status == 'pending'
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 300
        && request.resource.data.lines is list && request.resource.data.lines.size() <= 10
        && request.resource.data.path is string && request.resource.data.path.size() <= 200
        && freshProof(request.resource.data.proofId, getAfter(/databases/$(database)/documents/proofs/$(request.resource.data.proofId)).data.workerId)
      );
    }
  }
}
