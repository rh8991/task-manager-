# Only needed to run the site locally against a REAL Firebase project (copy to .env.local).
# For local development with the emulators instead, no config is needed: see README.
# These values are public by design (Firebase console → Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The mailer (scripts/mailer.ts) normally runs in GitHub Actions with these as repository secrets:
# FIREBASE_SERVICE_ACCOUNT, ADMIN_EMAILS, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, EMAIL_FROM
# and the repository variable APP_URL. Never put real secrets in this file or commit .env files.
