# --- Database: Neon Postgres, project "task-manager" (purple-grass-53608385) ---
# Org: Technoda - science program (org-lingering-haze-56034745), region aws-eu-central-1 (Frankfurt)
# Replace <password> with the neondb_owner password (Neon console → Connect). URL-encode special characters.
# Pooled connection: used by the app
DATABASE_URL="postgresql://neondb_owner:<password>@ep-rapid-bread-b9lpzhn6-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection: used by `prisma migrate` (runs automatically during `npm run build`)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<password>@ep-rapid-bread-b9lpzhn6.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# For local development against your own Postgres, point both at it, e.g.
# DATABASE_URL="postgresql://postgres@localhost:5432/taskmgr" (same value for DATABASE_URL_UNPOOLED)

# --- Manager access ---
ADMIN_PASSWORD="choose-a-strong-password"
# Random string, at least 32 characters (e.g. `openssl rand -base64 32`)
SESSION_SECRET=""

# Public address of the app, used for links inside emails (no trailing slash)
APP_URL="https://your-app.vercel.app"

# Secret for the scheduler that sends weekly reports and reminders
CRON_SECRET=""

# --- Email (SMTP). Works with any provider; workers can have any email address. ---
# Gmail:   SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (use an App Password)
# Outlook: SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Brevo:   SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 (free 300 emails/day)
# Resend:  SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_USER=resend SMTP_PASS=<api key>
# Leave SMTP_HOST empty to only log emails (development).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ניהול משימות <tasks@your-domain.com>"

# Optional: "true" = the shared dashboard is only visible via links from emails (or to the manager)
DASHBOARD_PRIVATE="false"
