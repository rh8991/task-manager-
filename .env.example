# --- Database (PostgreSQL). Free options: Neon (neon.tech) or Supabase. ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Manager access ---
ADMIN_PASSWORD="choose-a-strong-password"
# Random string, at least 32 characters (e.g. `openssl rand -base64 32`)
SESSION_SECRET=""

# Public address of the app, used for links inside emails (no trailing slash)
APP_URL="https://your-app.vercel.app"

# Secret for the scheduler that sends weekly reports and reminders
CRON_SECRET=""

# --- Email (SMTP). Works with any provider; workers can have any email address. ---
# Gmail:   SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (use an App Password)
# Outlook: SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Brevo:   SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 (free 300 emails/day)
# Resend:  SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_USER=resend SMTP_PASS=<api key>
# Leave SMTP_HOST empty to only log emails (development).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ניהול משימות <tasks@your-domain.com>"

# Optional: "true" = the shared dashboard is only visible via links from emails (or to the manager)
DASHBOARD_PRIVATE="false"
